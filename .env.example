PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/voice_sales_agent

# Single dashboard login
ADMIN_EMAIL=admin@demo.in
ADMIN_PASSWORD=change-me
JWT_SECRET=long-random-string

# Gnani Vachana: speech-to-text + text-to-speech (app.gnani.ai)
GNANI_API_KEY=

# OpenRouter: conversation, call analysis and RAG embeddings (openrouter.ai/keys)
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite
EMBED_MODEL=baai/bge-m3
